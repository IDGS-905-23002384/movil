<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/ReachTarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical">

            <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ubicación en el mapa" />

            <include
                android:id="@+id/mapaMiniDireccion"
                layout="@layout/view_mapa_tarjeta"
                android:layout_width="match_parent"
                android:layout_height="150dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvUbicacionEstado"
                    style="@style/ReachPequeno"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ubica tu domicilio para que el repartidor llegue sin problemas." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUbicarMapa"
                    style="@style/ReachBotonContorno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minHeight="40dp"
                    android:text="Ubicar"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_location"
                    app:iconSize="16dp"
                    app:iconTint="@color/azul" />
            </LinearLayout>

            <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tipo de dirección" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsAlias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip android:id="@+id/chipCasa" style="@style/ReachChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Casa" />
                <com.google.android.material.chip.Chip android:id="@+id/chipTrabajo" style="@style/ReachChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trabajo" />
                <com.google.android.material.chip.Chip android:id="@+id/chipOtro" style="@style/ReachChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Otro" />
            </com.google.android.material.chip.ChipGroup>

            <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="¿Quién recibe?" />
            <EditText android:id="@+id/etDirNombre" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:autofillHints="name" android:hint="Nombre completo" android:inputType="textPersonName|textCapWords" />

            <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Teléfono de contacto" />
            <EditText android:id="@+id/etDirTelefono" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:autofillHints="phone" android:hint="10 dígitos" android:inputType="phone" android:maxLength="10" />

            <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Calle" />
            <EditText android:id="@+id/etDirCalle" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:autofillHints="postalAddress" android:hint="Ej. Blvd. Adolfo López Mateos" android:inputType="textPostalAddress|textCapWords" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Núm. exterior" />
                    <EditText android:id="@+id/etDirExterior" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="1502" android:importantForAutofill="no" android:inputType="text" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Núm. interior" />
                    <EditText android:id="@+id/etDirInterior" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Opcional" android:importantForAutofill="no" android:inputType="text" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Colonia" />
            <EditText android:id="@+id/etDirColonia" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Colonia o fraccionamiento" android:importantForAutofill="no" android:inputType="textCapWords" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Código postal" />
                    <EditText android:id="@+id/etDirCp" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:autofillHints="postalCode" android:hint="37000" android:inputType="number" android:maxLength="5" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1.4" android:orientation="vertical">
                    <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ciudad" />
                    <EditText android:id="@+id/etDirCiudad" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="León" android:importantForAutofill="no" android:inputType="textCapWords" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Estado" />
            <AutoCompleteTextView android:id="@+id/etDirEstado" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:completionThreshold="1" android:hint="Guanajuato" android:importantForAutofill="no" android:inputType="textCapWords" />

            <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Referencias (opcional)" />
            <EditText android:id="@+id/etDirReferencias" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:hint="Entre calles, color de fachada…" android:importantForAutofill="no" android:inputType="textMultiLine|textCapSentences" android:maxLength="250" android:minLines="2" />

            <CheckBox
                android:id="@+id/cbDirPredeterminada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/azul"
                android:text="Usar como dirección predeterminada"
                android:textColor="@color/texto_sec"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/barraDireccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_inferior"
        android:elevation="12dp"
        android:padding="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarDireccion"
            style="@style/ReachBotonPrimario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar dirección" />
    </LinearLayout>
</LinearLayout>
