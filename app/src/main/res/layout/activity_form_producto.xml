<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollFormProducto"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    style="@style/ReachTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivPreviewProducto"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="@drawable/bg_imagen"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter" />

                    <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="URL de la imagen" />
                    <EditText android:id="@+id/etImagenUrl" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:hint="/img/productos/mi-producto.webp o https://…" android:importantForAutofill="no" android:inputType="textUri" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ReachTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView style="@style/ReachSeccion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="Datos generales" />

                    <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SKU" />
                    <EditText android:id="@+id/etSku" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ej. MSI-RTX4060-V2X" android:importantForAutofill="no" android:inputType="textCapCharacters" android:maxLength="40" />

                    <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nombre" />
                    <EditText android:id="@+id/etNombreProducto" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nombre comercial" android:importantForAutofill="no" android:inputType="textCapSentences" android:maxLength="200" />

                    <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Marca" />
                    <EditText android:id="@+id/etMarcaProducto" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ej. ASUS" android:importantForAutofill="no" android:inputType="textCapWords" android:maxLength="80" />

                    <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Categoría" />
                    <Spinner android:id="@+id/spCategoria" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="48dp" />

                    <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Proveedor" />
                    <Spinner android:id="@+id/spProveedor" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="48dp" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ReachTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView style="@style/ReachSeccion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="Precio e inventario" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Precio (IVA incl.)" />
                            <EditText android:id="@+id/etPrecioProducto" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="0.00" android:importantForAutofill="no" android:inputType="numberDecimal" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Precio anterior" />
                            <EditText android:id="@+id/etPrecioAnterior" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Opcional" android:importantForAutofill="no" android:inputType="numberDecimal" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Existencias" />
                            <EditText android:id="@+id/etStock" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="0" android:importantForAutofill="no" android:inputType="number" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Stock mínimo" />
                            <EditText android:id="@+id/etStockMinimo" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="5" android:importantForAutofill="no" android:inputType="number" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swDestacado" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Destacado en inicio" android:textColor="@color/texto_sec" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swEnvio" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Disponible para envío" android:textColor="@color/texto_sec" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swActivo" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Visible en la tienda" android:textColor="@color/texto_sec" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ReachTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView style="@style/ReachSeccion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="Contenido" />

                    <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Descripción" />
                    <EditText android:id="@+id/etDescripcionProducto" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:hint="Describe el producto" android:importantForAutofill="no" android:inputType="textMultiLine|textCapSentences" android:maxLength="2000" android:minLines="3" />

                    <TextView style="@style/ReachEtiqueta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Especificaciones (una por línea, formato Clave: valor)" />
                    <EditText android:id="@+id/etEspecificaciones" style="@style/ReachCampo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:gravity="top" android:hint="Memoria: 12 GB GDDR6X" android:importantForAutofill="no" android:inputType="textMultiLine" android:maxLength="4000" android:minLines="4" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardCompatibilidad"
                    style="@style/ReachTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView style="@style/ReachEyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Arma tu PC" />
                    <TextView style="@style/ReachSeccion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Datos de compatibilidad" />
                    <TextView style="@style/ReachCuerpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="Se usan para filtrar piezas compatibles en el configurador." android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/llCompatibilidad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/progresoFormProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/azul"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/barraFormProducto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_inferior"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEstadoProducto"
            style="@style/ReachBotonPeligro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="Desactivar"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarProducto"
            style="@style/ReachBotonPrimario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:text="Guardar producto" />
    </LinearLayout>
</LinearLayout>
