<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollRecomendador"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/contenidoRecomendador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                style="@style/ReachTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/ReachEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paso 1" />

                <TextView
                    style="@style/ReachSeccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="¿Para qué usarás tu PC?" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsUso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip android:id="@+id/chipUsoOficina" style="@style/ReachChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="OFICINA" android:text="Oficina y escuela" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipUsoFhd" style="@style/ReachChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:tag="GAMING_FHD" android:text="Gaming 1080p" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipUsoQhd" style="@style/ReachChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="GAMING_QHD" android:text="Gaming 1440p" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipUsoCreacion" style="@style/ReachChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="CREACION" android:text="Edición y creación" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:id="@+id/tvUsoDescripcion"
                    style="@style/ReachCuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/borde" />

                <TextView
                    style="@style/ReachEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paso 2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ReachSeccion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tu presupuesto" />

                    <TextView
                        android:id="@+id/tvPresupuesto"
                        style="@style/ReachPrecio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderPresupuesto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Presupuesto"
                    android:stepSize="500"
                    android:value="22000"
                    android:valueFrom="10000"
                    android:valueTo="100000"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/azul"
                    app:trackColorActive="@color/azul"
                    app:trackColorInactive="@color/azul_claro" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ReachPequeno"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$10,000" />

                    <TextView
                        style="@style/ReachPequeno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$100,000" />
                </LinearLayout>

                <TextView
                    style="@style/ReachPequeno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Incluye ensamble, pruebas y solo componentes en existencia." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecomendar"
                    style="@style/ReachBotonPrimario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Recomendar equipos"
                    app:icon="@drawable/ic_bolt"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progresoRecomendador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/azul"
                app:trackColor="@color/azul_claro" />

            <TextView
                android:id="@+id/tvAvisoRecomendador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_aviso_ambar"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:textColor="@color/ambar_oscuro"
                android:textSize="13sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_warning"
                app:drawableTint="@color/ambar_oscuro" />

            <TextView
                android:id="@+id/tvTituloResultados"
                style="@style/ReachSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSubtituloResultados"
                style="@style/ReachCuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Todas son 100% compatibles. Puedes agregarlas directo o ajustarlas en Arma tu PC."
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llRecomendaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
